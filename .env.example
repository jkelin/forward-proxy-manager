# Required: URL returning HOST:PORT:USERNAME:PASSWORD SOCKS5 proxies, newline separated.
PROXY_LIST_URL=https://example.com/proxies

IP_CHECK_URL=https://ifconfig.io/ip
REQUEST_TIMEOUT=20s
RETRY_TIMEOUT=5s
INITIAL_IP_INFO_TIMEOUT=10s
RETRIES=1
THROTTLE_REQUESTS_PER_MIN=30
THROTTLE_REQUESTS_BURST=5
UNREACHABLE_CLIENT_RETRY=60s
ENABLE_WEB=false
PROXY_PORT=8080
WEB_PORT=8081
GRPC_PORT=8082

# Optional Cloudflare challenge solving (paths relative to src/, where `just dev` runs).
# Build the solver first: just build-solver
CHALLENGE_SOLVER=
CHALLENGE_PROFILE=../vendor/cfsolve/profiles/safari-26-ios.json
CHALLENGE_TIMEOUT=120s
CHALLENGE_CONCURRENCY=2
